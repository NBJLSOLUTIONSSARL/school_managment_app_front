# URL of the existing Spring Boot API. Used server-side by the Next.js proxy.
BACKEND_API_URL=http://localhost:8080

# Public site URL used for canonical links, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Institution identity. These values are displayed on the public website.
NEXT_PUBLIC_INSTITUTION_NAME=Etablissement Scolaire
NEXT_PUBLIC_INSTITUTION_SHORT_NAME=ES
NEXT_PUBLIC_INSTITUTION_TAGLINE=Un espace numerique au service des familles et de l'equipe pedagogique.

# Contact details. Leave empty when the institution has not published them yet.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_HOURS=

# Link to the existing React back-office (administration space).
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:5173
