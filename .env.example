# Base URL of the backend API. Keep "/api" when a reverse proxy serves the backend.
VITE_API_BASE_URL=/api

# Deployment sub-path (use "/" for a domain root, or "/school/" for a sub-directory).
VITE_BASE_PATH=/

# Local development server port.
VITE_DEV_PORT=3000

# Emit production sourcemaps (true/false).
VITE_BUILD_SOURCEMAP=false
